class TimeSeriesLatestDatapointsUDTF:
    """UDTF for retrieving the latest datapoint(s) for one or more Time Series using instance_id.
    
    Uses vectorized Arrow UDTF (PySpark 4.0.0+) for zero-copy performance.
    Similar to client.time_series.data.retrieve_latest()
    Returns rows in format: (time_series_external_id, timestamp, value, status_code)
    Note: time_series_external_id is in format "space:external_id" to support time series from different spaces.
    """
    
    def __init__(self) -> None:
        """Initialize UDTF (no parameters allowed when using analyze method).
        
        Token initialization happens in eval() for all registration modes.
        """
        # Initialize instance variables
        self._token_cache: dict[str, str | float] | None = None
        self._init_error: str | None = None
        self._init_error_category: str | None = None
        self._init_success = True
    
    @staticmethod
    def outputSchema() -> StructType:
        """Return schema: (time_series_external_id, timestamp, value, status_code)."""
        return StructType([
            StructField("time_series_external_id", StringType(), nullable=True),
            StructField("timestamp", TimestampType(), nullable=True),
            StructField("value", DoubleType(), nullable=True),
            StructField("status_code", IntegerType(), nullable=True),
        ])
    
    @staticmethod
    def analyze(
        instance_ids,
        before,
        include_status,
        client_id,
        client_secret,
        tenant_id,
        cdf_cluster,
        project,
    ):
        """Analyze method required by PySpark Connect for session-scoped UDTFs.
        
        Args:
            instance_ids: Comma-separated list of instance IDs column (format: "space:external_id")
            before: Get latest before this time column (ISO 8601 or "1h-ago", "now", etc.)
            include_status: Include status code column (boolean)
            client_id, client_secret, tenant_id, cdf_cluster, project: OAuth credential columns
        """
        from pyspark.sql.udtf import AnalyzeResult
        return AnalyzeResult(TimeSeriesLatestDatapointsUDTF.outputSchema())
    
    @udtf(useArrow=True)
    def eval(
        self,
        instance_ids: pa.Array | None = None,  # Comma-separated: "space1:ext_id1,space2:ext_id2"
        before: pa.Array | None = None,  # Get latest before this time (e.g., "1h-ago")
        include_status: pa.Array | None = None,
        client_id: pa.Array | None = None,
        client_secret: pa.Array | None = None,
        tenant_id: pa.Array | None = None,
        cdf_cluster: pa.Array | None = None,
        project: pa.Array | None = None,
    ) -> Iterator[pa.RecordBatch]:
        """Retrieve latest datapoint(s) for one or more time series using instance_id.
        
        Uses vectorized Arrow UDTF for zero-copy performance.
        
        Args:
            instance_ids: Comma-separated list of instance IDs (Arrow Array, extract scalar)
            before: Get latest before this time (Arrow Array, extract scalar)
            include_status: Include status code in output (Arrow Array, extract scalar)
            client_id, client_secret, tenant_id, cdf_cluster, project: OAuth credentials (Arrow Arrays)
        
        Yields:
            Arrow RecordBatches with (time_series_external_id, timestamp, value, status_code) columns
        """
        try:
            # Extract scalar values from Arrow Arrays
            if client_id is None or len(client_id) == 0:
                error_msg = "Missing credentials: client_id is required"
                error_category = 'CONFIGURATION'
                sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                yield self._empty_record_batch()
                return
            
            client_id_str = client_id[0].as_py() if client_id else None
            client_secret_str = client_secret[0].as_py() if client_secret and len(client_secret) > 0 else None
            tenant_id_str = tenant_id[0].as_py() if tenant_id and len(tenant_id) > 0 else None
            cdf_cluster_str = cdf_cluster[0].as_py() if cdf_cluster and len(cdf_cluster) > 0 else None
            project_str = project[0].as_py() if project and len(project) > 0 else None
            
            if not all([client_id_str, client_secret_str, tenant_id_str, cdf_cluster_str, project_str]):
                error_msg = "Missing required credentials or configuration"
                error_category = 'CONFIGURATION'
                sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                yield self._empty_record_batch()
                return
            
            instance_ids_str = instance_ids[0].as_py() if instance_ids and len(instance_ids) > 0 else None
            if not instance_ids_str:
                error_msg = "instance_ids is required (format: 'space1:ext_id1,space2:ext_id2')"
                error_category = 'CONFIGURATION'
                sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                yield self._empty_record_batch()
                return
            
            before_str = before[0].as_py() if before and len(before) > 0 else "now"
            include_status_bool = include_status[0].as_py() if include_status and len(include_status) > 0 else False
            
            # Parse instance_ids
            node_ids = []
            for instance_id_str in instance_ids_str.split(","):
                instance_id_str = instance_id_str.strip()
                if not instance_id_str:
                    continue
                if ":" not in instance_id_str:
                    error_msg = f"Invalid instance_id format '{instance_id_str}'. Expected format: 'space:external_id'"
                    error_category = 'CONFIGURATION'
                    sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                    yield self._empty_record_batch()
                    return
                space, external_id = instance_id_str.split(":", 1)
                space = space.strip()
                external_id = external_id.strip()
                if not space or not external_id:
                    error_msg = f"Invalid instance_id format '{instance_id_str}'. Both space and external_id must be non-empty."
                    error_category = 'CONFIGURATION'
                    sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                    yield self._empty_record_batch()
                    return
                node_ids.append({"space": space, "externalId": external_id})
            
            if not node_ids:
                error_msg = "At least one valid instance_id is required"
                error_category = 'CONFIGURATION'
                sys.stderr.write(f"[UDTF] ✗ {error_category}: {error_msg}\n")
                yield self._empty_record_batch()
                return
            
            # Get OAuth token (with caching)
            try:
                token, expires_at = _get_oauth_token(
                    client_id_str,
                    client_secret_str,
                    tenant_id_str,
                    cdf_cluster_str,
                    self._token_cache,
                )
                # Cache token for next call
                self._token_cache = {
                    "access_token": token,
                    "expires_at": expires_at,
                }
            except Exception as e:
                try:
                    self._init_error_category = _classify_error(None, e)
                except Exception:
                    self._init_error_category = 'UNKNOWN'
                self._init_error = f"{type(e).__name__}: {str(e)}"
                sys.stderr.write(f"[UDTF] ✗ {self._init_error_category}: {self._init_error}\n")
                yield self._empty_record_batch()
                return
            
            try:
                sys.stderr.write(f"[UDTF] Querying latest datapoints for {len(node_ids)} time series\n")
                
                # Make direct REST call to CDF API (latest endpoint uses JSON)
                base_url = f"https://{cdf_cluster_str}.cognitedata.com"
                api_path = f"/api/v1/projects/{project_str}/timeseries/data/latest"
                full_url = f"{base_url}{api_path}"
                
                # Build request payload
                payload = {
                    "items": node_ids,
                    "before": before_str,
                }
                
                # Make request (JSON response for latest endpoint)
                response = _make_request(
                    method="POST",
                    url=full_url,
                    token=token,
                    json_data=payload,
                    timeout=30,
                    accept_protobuf=False,  # Latest endpoint uses JSON
                )
                
                # Parse JSON response
                response_data = response.json()
                items = response_data.get("items", [])
                
                # Convert to Arrow Table
                timestamps: list[int | None] = []
                values: list[float | None] = []
                ts_external_ids: list[str | None] = []
                status_codes: list[int | None] = []
                
                for item in items:
                    instance_id_dict = item.get("instanceId", {})
                    space = instance_id_dict.get("space")
                    ext_id = instance_id_dict.get("externalId")
                    ts_external_id = f"{space}:{ext_id}" if space and ext_id else None
                    
                    datapoints = item.get("datapoints", [])
                    if datapoints:
                        latest_dp = datapoints[0]  # First is latest
                        timestamps.append(latest_dp.get("timestamp"))
                        values.append(latest_dp.get("value"))
                        ts_external_ids.append(ts_external_id)
                        if include_status_bool:
                            status_codes.append(latest_dp.get("statusCode"))
                        else:
                            status_codes.append(None)
                
                # Build Arrow arrays
                if not timestamps:
                    # Return empty RecordBatch
                    yield self._empty_record_batch()
                    return
                
                # Convert timestamps (int64 milliseconds) to Arrow timestamp arrays
                timestamp_array = pa.array(timestamps, type=pa.timestamp('ms'))
                value_array = pa.array(values, type=pa.float64())
                ts_external_id_array = pa.array(ts_external_ids, type=pa.string())
                status_code_array = pa.array(status_codes, type=pa.int64())
                
                schema = pa.schema([
                    pa.field("time_series_external_id", pa.string(), nullable=True),
                    pa.field("timestamp", pa.timestamp('ms'), nullable=True),
                    pa.field("value", pa.float64(), nullable=True),
                    pa.field("status_code", pa.int64(), nullable=True),
                ])
                
                arrow_table = pa.Table.from_arrays(
                    [ts_external_id_array, timestamp_array, value_array, status_code_array],
                    schema=schema
                )
                
                # Convert to RecordBatches and yield
                batches = arrow_table.to_batches(max_chunksize=8192)
                for batch in batches:
                    yield batch
                
                sys.stderr.write(f"[UDTF] ✓ Successfully yielded {arrow_table.num_rows} rows\n")
                
            except Exception as e:
                # Log error for debugging
                error_info = f"[UDTF] ✗ Error during query: {type(e).__name__}: {str(e)}\n{traceback.format_exc()}"
                sys.stderr.write(error_info)
                # Yield empty RecordBatch to match schema
                yield self._empty_record_batch()
                
        except Exception as outer_error:
            # Last resort: if anything goes wrong, yield empty RecordBatch
            error_info = f"ERROR: Unexpected error in eval(): {type(outer_error).__name__}: {str(outer_error)}"
            sys.stderr.write(f"{error_info}\n{traceback.format_exc()}\n")
            yield self._empty_record_batch()

    def _empty_record_batch(self) -> pa.RecordBatch:
        """Create empty RecordBatch with correct schema."""
        schema = pa.schema([
            pa.field("time_series_external_id", pa.string(), nullable=True),
            pa.field("timestamp", pa.timestamp('ms'), nullable=True),
            pa.field("value", pa.float64(), nullable=True),
            pa.field("status_code", pa.int64(), nullable=True),
        ])
        return pa.RecordBatch.from_arrays(
            [
                pa.array([], type=pa.string()),
                pa.array([], type=pa.timestamp('ms')),
                pa.array([], type=pa.float64()),
                pa.array([], type=pa.int64()),
            ],
            schema=schema
        )
