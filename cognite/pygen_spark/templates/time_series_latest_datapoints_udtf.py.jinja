                return
            
            try:
                # Log query start (both stderr and stdout for Serverless SQL visibility)
                query_start = f"[UDTF] Querying latest datapoints for {len(node_ids)} time series"
                sys.stderr.write(f"{query_start}\n")
                print(query_start)  # Also print to stdout for Serverless SQL visibility
{% if debug %}
                _write_debug_log(query_start)
{% endif %}
                
                # Make direct REST call to CDF API (latest endpoint uses JSON)
                base_url = f"https://{cdf_cluster_str}.cognitedata.com"
                api_path = f"/api/v1/projects/{project_str}/timeseries/data/latest"
                full_url = f"{base_url}{api_path}"
                
                # Build request payload
                payload = {
                    "items": node_ids,
                    "before": before_str,
                }
                
                # Make request (JSON response for latest endpoint)
                response = _make_request(
                    method="POST",
                    url=full_url,
                    token=token,
                    json_data=payload,
                    timeout=30,
                    accept_protobuf=False,  # Latest endpoint uses JSON
                )
                
{% if debug %}
                # Log successful CDF query (both stderr and stdout for Serverless SQL visibility)
                query_success = f"[UDTF] SUCCESS: queried CDF API (status: {response.status_code})"
                sys.stderr.write(f"{query_success}\n")
                print(query_success)  # Also print to stdout for Serverless SQL visibility
                _write_debug_log(query_success)
                debug_api_status = str(response.status_code)
{% endif %}
                
                # Parse JSON response
                response_data = response.json()
                items = response_data.get("items", [])
{% if debug %}
                items_count = len(items)
                api_info = f"[UDTF] API returned {items_count} items from CDF"
                _write_debug_log(api_info)
                debug_api_items_count = items_count
{% endif %}
                
                # Build scalar rows from JSON response
                timestamps: list[int | None] = []
                values: list[float | None] = []
                ts_external_ids: list[str | None] = []
                status_codes: list[int | None] = []

                for item in items:
                    instance_id_dict = item.get("instanceId", {})
                    space = instance_id_dict.get("space")
                    ext_id = instance_id_dict.get("externalId")
                    ts_external_id = f"{space}:{ext_id}" if space and ext_id else None

                    datapoints = item.get("datapoints", [])
                    if datapoints:
                        latest_dp = datapoints[0]
                        timestamps.append(latest_dp.get("timestamp"))
                        values.append(latest_dp.get("value"))
                        ts_external_ids.append(ts_external_id)
                        if include_status_bool:
                            status_codes.append(latest_dp.get("statusCode"))
                        else:
                            status_codes.append(None)

                if not timestamps:
                    sys.stderr.write(
                        "[UDTF] WARNING: No latest datapoints found, yielding empty row to prevent 'end-of-input' error\n"
                    )
{% if debug %}
                    debug_execution_mode = "scalar"
                    debug_rows_yielded = 0
                    debug_error = "NO_DATA"
                    yield (
                        None,
                        None,
                        None,
                        None,
                        debug_auth_status,
                        debug_api_status,
                        debug_api_items_count,
                        "scalar",
                        0,
                        debug_error,
                    )
{% else %}
                    yield (None, None, None, None)
{% endif %}
                    return

                row_count = len(timestamps)
{% if debug %}
                debug_execution_mode = "scalar"
                debug_rows_yielded = row_count
{% endif %}

                for ts_external_id, ts, val, status in zip(ts_external_ids, timestamps, values, status_codes):
                    timestamp_dt = (
                        datetime.fromtimestamp(ts / 1000.0, tz=timezone.utc) if ts is not None else None
                    )
{% if debug %}
                    yield (
                        ts_external_id,
                        timestamp_dt,
                        val,
                        status,
                        debug_auth_status,
                        debug_api_status,
                        debug_api_items_count,
                        "scalar",
                        row_count,
                        debug_error,
                        debug_credential_types,
                        debug_credential_extracted,
                        debug_missing_credentials,
                        debug_token,
                    )
{% else %}
                    yield (ts_external_id, timestamp_dt, val, status)
{% endif %}

                success_msg = f"[UDTF] SUCCESS: yielded {row_count} rows (scalar mode)"
                sys.stderr.write(f"{success_msg}\n")
                print(success_msg)  # Also print to stdout for Serverless SQL visibility
{% if debug %}
                _write_debug_log(success_msg)
                debug_rows_yielded = row_count
{% endif %}

            except Exception as e:
                # Log error for debugging (without traceback to avoid import issues)
                # Both stderr and stdout for Serverless SQL visibility
                error_info = f"[UDTF] ✗ Error during query: {type(e).__name__}: {str(e)}"
                sys.stderr.write(error_info)
                print(error_info)  # Also print to stdout for Serverless SQL visibility
{% if debug %}
                _write_debug_log(error_info)
                debug_error = f"{type(e).__name__}: {str(e)}"
                yield (
                    None,
                    None,
                    None,
                    None,
                    debug_auth_status,
                    debug_api_status,
                    debug_api_items_count,
                    "scalar",
                    0,
                    debug_error,
                    debug_credential_types,
                    debug_credential_extracted,
                    debug_missing_credentials,
                    debug_token,
                )
{% else %}
                yield (None, None, None, None)
{% endif %}
                return
                
        except Exception as outer_error:
            # Last resort: if anything goes wrong, yield empty row
            # Both stderr and stdout for Serverless SQL visibility
            error_info = f"ERROR: Unexpected error in eval(): {type(outer_error).__name__}: {str(outer_error)}"
            sys.stderr.write(f"{error_info}\n")
            print(error_info)  # Also print to stdout for Serverless SQL visibility
{% if debug %}
            _write_debug_log(error_info)
            debug_error = f"{type(outer_error).__name__}: {str(outer_error)}"
{% endif %}
            return

