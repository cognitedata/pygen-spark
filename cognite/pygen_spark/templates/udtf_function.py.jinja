{% endfor %}
            ]
            view_key = "{{ view.external_id }}/{{ view.version }}"
            space_name = "{{ view.space }}"

            def _resolve_view_properties(item: dict) -> dict:
                """Resolve this instance's property dict for the view exactly once.

                Wide views (many columns) previously re-walked the nested
                ``sources`` / ``properties`` structure once per column, which is
                O(columns x depth) per row. Resolving the dict once makes property
                lookup O(depth + columns). Values from ``sources`` take precedence
                over ``properties`` (matching prior per-column fallback behavior).
                """
                resolved: dict[str, object] = {}
                properties_dict = item.get("properties")
                if isinstance(properties_dict, dict):
                    space_data = properties_dict.get(space_name)
                    if isinstance(space_data, dict):
                        view_data = space_data.get(view_key)
                        if isinstance(view_data, dict):
                            resolved.update(view_data)
                    if not resolved:
                        for space_data in properties_dict.values():
                            if isinstance(space_data, dict):
                                view_data = space_data.get(view_key)
                                if isinstance(view_data, dict):
                                    resolved.update(view_data)
                                    break
                sources = item.get("sources")
                if isinstance(sources, list):
                    # CDF v3 API: sources is a list of {source, properties} objects
                    # (see NodeOrEdgeData in cognite-sdk-python).
                    for source_item in sources:
                        if not isinstance(source_item, dict):
                            continue
                        source_ref = source_item.get("source", {})
                        if not isinstance(source_ref, dict):
                            continue
                        s_space = source_ref.get("space")
                        s_ext_id = source_ref.get("externalId") or source_ref.get("external_id")
                        s_ver = source_ref.get("version")
                        if s_space == space_name and f"{s_ext_id}/{s_ver}" == view_key:
                            view_data = source_item.get("properties")
                            if isinstance(view_data, dict):
                                for key, value in view_data.items():
