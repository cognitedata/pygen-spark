        """Return the output schema for this UDTF."""
        fields = [
{% for prop in properties %}
            StructField("{{ prop.name }}", {{ prop.spark_type }}, nullable={{ prop.nullable }}),
{% endfor %}
            StructField("space", StringType(), nullable=False),
