            # does not OOM workers on very wide views. Computed at codegen from a fixed
            # per-page cell budget: min(1000, max(25, budget // num_columns)).
            # This view has {{ (properties | length) }} column(s).
{% set _num_columns = (properties | length) or 1 %}
            page_limit = {{ [1000, [25, (50000 // _num_columns)] | max] | min }}

            # Pagination: iterate through all pages using nextCursor
            next_cursor: str | None = None
            rows_yielded = 0
            while True:
                request_limit = page_limit
                if effective_row_limit is not None:
                    remaining = effective_row_limit - rows_yielded
                    if remaining <= 0:
