                    row_values.append(_cdf_timestamp_value_to_datetime(item.get("createdTime")))
                    row_values.append(_cdf_timestamp_value_to_datetime(item.get("lastUpdatedTime")))
                    row_values.append(_cdf_timestamp_value_to_datetime(item.get("deletedTime")))

                    yield tuple(row_values)
                    rows_yielded += 1
                    if effective_row_limit is not None and rows_yielded >= effective_row_limit:
                        stop_early = True
