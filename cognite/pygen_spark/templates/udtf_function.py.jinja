                    # Yield nothing (empty iterator) - Spark will handle this
                    return

    def _empty_record_batch(self) -> pa.RecordBatch:
        """Create empty RecordBatch with correct schema."""
        import pyarrow as pa
        
        try:
            schema = self._arrow_schema()
            expected_cols = len(schema)
            
            # CRITICAL: Wrap batch creation in try-catch to prevent malformed batches
            try:
                empty_batch = pa.RecordBatch.from_arrays(
                    [pa.array([], type=field.type) for field in schema], 
                    schema=schema
                )
                
                # Validate the batch
                if len(empty_batch.schema) != expected_cols:
                    raise ValueError(
                        f"CRITICAL: _empty_record_batch created batch with {len(empty_batch.schema)} columns, "
                        f"expected {expected_cols}"
                    )
                
                return empty_batch
            except Exception as batch_error:
                # If batch creation fails, log and fall through to minimal batch
                error_msg = f"CRITICAL: Failed to create empty batch: {type(batch_error).__name__}: {str(batch_error)}"
                sys.stderr.write(f"{error_msg}\n")
                print(error_msg)
                # Fall through to minimal batch creation
                raise
            
        except Exception as e:
            # If even this fails, try one more time with a different approach
            import pyarrow as pa
            try:
                # Try to get schema again and create arrays for all fields
                schema = self._arrow_schema()
                expected_cols = len(schema)
                
                # Create arrays with error message for all fields
                arrays = []
                for field in schema:
                    # Create array with single error message value
                    error_msg = f"Error creating empty batch: {str(e)}"
                    arrays.append(pa.array([error_msg], type=field.type))
                
                # Create batch with all columns
                error_batch = pa.RecordBatch.from_arrays(arrays, schema=schema)
                
                # Validate
                if len(error_batch.schema) != expected_cols:
                    # If validation fails, raise instead of returning wrong schema
                    raise ValueError(
                        f"CRITICAL: Cannot create batch with correct schema. "
                        f"Expected {expected_cols} columns, got {len(error_batch.schema)}"
                    )
                
                return error_batch
            except Exception as final_error:
                # If we absolutely cannot create a batch with correct schema, raise
                # This is better than returning a batch with wrong schema
                raise RuntimeError(
                    f"CRITICAL: Cannot create RecordBatch with correct schema. "
                    f"Original error: {str(e)}, Final error: {str(final_error)}"
                ) from e

    def _arrow_schema(self) -> pa.Schema:
        """Build Arrow schema from view properties."""
        # Defensive import: ensure pyarrow is available (Unity Catalog execution context)
        import pyarrow as pa
        
        fields = []
{% for prop in properties %}
        # {{ prop.name }}: {{ prop.spark_type }}
        {% if "String" in prop.spark_type or "Array" in prop.spark_type %}
        fields.append(pa.field("{{ prop.name }}", pa.string(), nullable=True))
        {% elif "Long" in prop.spark_type or "Integer" in prop.spark_type %}
        fields.append(pa.field("{{ prop.name }}", pa.int64(), nullable=True))
        {% elif "Double" in prop.spark_type or "Float" in prop.spark_type %}
        fields.append(pa.field("{{ prop.name }}", pa.float64(), nullable=True))
        {% elif "Boolean" in prop.spark_type %}
        fields.append(pa.field("{{ prop.name }}", pa.bool_(), nullable=True))
        {% elif "Timestamp" in prop.spark_type %}
        fields.append(pa.field("{{ prop.name }}", pa.timestamp('ms'), nullable=True))
        {% else %}
        fields.append(pa.field("{{ prop.name }}", pa.string(), nullable=True))
        {% endif %}
{% endfor %}
        fields.append(pa.field("space", pa.string(), nullable=True))
        fields.append(pa.field("external_id", pa.string(), nullable=True))
{% if debug %}
        # Add diagnostic columns when debug=True
        fields.extend([
            pa.field("_debug_auth_status", pa.string(), nullable=True),
            pa.field("_debug_api_status", pa.string(), nullable=True),
            pa.field("_debug_api_items_count", pa.int64(), nullable=True),
            pa.field("_debug_execution_mode", pa.string(), nullable=True),
            pa.field("_debug_rows_yielded", pa.int64(), nullable=True),
            pa.field("_debug_error", pa.string(), nullable=True),
            pa.field("_debug_schema_info", pa.string(), nullable=True),
            pa.field("_debug_column_count", pa.int64(), nullable=True),
            pa.field("_debug_column_names", pa.string(), nullable=True),
        ])
{% endif %}
        return pa.schema(fields)

    def _build_filter_json(self, filters: dict[str, object]) -> dict | None:
        """Build CDF API filter JSON from input parameters.
        
        Replicates SDK's filter serialization format exactly.
        
        Args:
            filters: Dictionary of filter conditions
            
        Returns:
            CDF API filter JSON dict or None if no filters
        """
        # Filter out None values
        active_filters = {k: v for k, v in filters.items() if v is not None}
        
        if not active_filters:
            return None
        
        # Build property references and filter conditions
        filter_conditions = []
        
        for prop_name, prop_value in active_filters.items():
            # Create property reference as list (matches SDK format)
            # Format: ["space", "view_external_id/view_version", "property_name"]
            property_ref = [
                "{{ view.space }}",
                "{{ view.external_id }}/{{ view.version }}",
                prop_name,
            ]
            
            # Handle different value types
            if isinstance(prop_value, list):
                # List values use In filter
                filter_conditions.append({
                    "in": {
                        "property": property_ref,
                        "values": prop_value,
                    }
                })
            else:
                # Single values use Equals filter
                filter_conditions.append({
                    "equals": {
                        "property": property_ref,
                        "value": prop_value,
                    }
                })
        
        # Combine multiple filters with And
        if len(filter_conditions) == 1:
            return filter_conditions[0]
        elif len(filter_conditions) > 1:
            return {"and": filter_conditions}
        else:
            return None

